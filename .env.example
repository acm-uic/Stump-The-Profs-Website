# Copy this file to .env and fill in the values. .env is never committed.

# The password for /admin.html. Use a long phrase nobody will guess.
ADMIN_KEY=

# Optional. The port to listen on (default 3000).
# PORT=3000

# Optional. The address shown on the projector, e.g. https://stumptheprofs.acmuic.org
# PUBLIC_URL=

# Optional. Where the game is saved (default data/state.json).
# SAVE_PATH=data/state.json
