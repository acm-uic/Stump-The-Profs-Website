  "cards": [
    {
      "dot": "emerald",
      "title": "Sealed until read",
      "items": [
        "The admin view carries every sealed answer",
        "The projector and teams only see how many are in",
        "An answer reaches everyone once it is read out"
      ]
    },
    {
      "dot": "cyan",
      "title": "The server owns time",
      "items": [
        "Lock-ins are timed with the server clock",
        "Pages count down from a duration, not a clock time",
        "A timer closes answers when the clock runs out"
      ]
    },
    {
      "dot": "amber",
      "title": "One path for every change",
      "items": [
        "Every accepted action ends in broadcast()",
        "broadcast() sends each audience its view, then saves",
        "A restart reloads the save; only Undo is lost"
      ]
    }
  ]
