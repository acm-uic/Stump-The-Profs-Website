  "cards": [
    {
      "dot": "cyan",
      "title": "Host keys",
      "items": [
        "N shows the next question",
        "O opens answers and starts the clock",
        "A reads the next sealed answer",
        "C or W rules on a free-response answer",
        "R reveals the answer at any point; Z undoes"
      ]
    },
    {
      "dot": "violet",
      "title": "When stages change",
      "items": [
        "close: the clock runs out, every team is in, or the host presses A",
        "done: the first right answer, or the last answer read",
        "Nobody answered: the answer is revealed straight away"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why nobody can copy",
      "items": [
        "BUZZ seals a team's answer; only the host sees it",
        "Nothing is said aloud until answers close",
        "Multiple choice and true/false judge themselves when read"
      ]
    },
    {
      "dot": "amber",
      "title": "Points",
      "items": [
        "First right answer in reading order: full points",
        "Every other right answer: a quarter",
        "Wrong or no answer: nothing"
      ]
    }
  ]
